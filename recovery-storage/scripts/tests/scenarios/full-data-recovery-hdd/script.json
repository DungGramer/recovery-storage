{
 "name": "full-data-recovery-hdd",
 "structural": true,
 "covers": [
  "G9"
 ],
 "steps": [
  {
   "cli": [
    "session",
    "new",
    "--goal",
    "data-recovery",
    "--goal",
    "device-recovery",
    "--ceiling",
    "R2"
   ],
   "save": {
    "sid": "session.id"
   }
  },
  {
   "cli": [
    "ingest",
    "smartctl",
    "@fx:smartctl/scrutiny-usbjmicron-hdd-failing.json",
    "--session",
    "$sid"
   ],
   "save": {
    "dev": "device_id"
   }
  },
  {
   "cli": [
    "assess",
    "$sid",
    "$dev"
   ]
  },
  {
   "cli": [
    "ingest",
    "ddrescue",
    "$sid",
    "$dev",
    "@fx:ingest/ddrescue-manual-1.30.map"
   ],
   "save": {
    "ev1": "evidence.id"
   }
  },
  {
   "cli": [
    "session",
    "data-state",
    "$sid",
    "$dev",
    "secured",
    "--evidence",
    "$ev1"
   ],
   "exit": 3,
   "reasons": [
    "image-incomplete"
   ]
  },
  {
   "cli": [
    "gate",
    "open",
    "$sid",
    "$dev",
    "format"
   ],
   "runner": {
    "capture": "windows/baseline-nvme-only"
   },
   "exit": 3,
   "reasons": [
    "data-not-secured"
   ]
  },
  {
   "cli": [
    "inventory",
    "--session",
    "$sid"
   ],
   "runner": {
    "capture": "windows/baseline-nvme-only"
   },
   "save": {
    "dest": "observations[os_path=/dev/pd1].device_id"
   }
  },
  {
   "cli": [
    "gate",
    "open",
    "$sid",
    "$dev",
    "image-ddrescue",
    "--dest-device",
    "$dest"
   ],
   "runner": {
    "capture": "windows/baseline-nvme-only"
   },
   "exit": 3,
   "reasons": [
    "device-not-found"
   ]
  },
  {
   "cli": [
    "ingest",
    "ddrescue",
    "$sid",
    "$dev",
    "@fx:ingest/ddrescue-finished.hitachi500.derived.map"
   ],
   "save": {
    "ev2": "evidence.id"
   }
  },
  {
   "cli": [
    "session",
    "data-state",
    "$sid",
    "$dev",
    "secured",
    "--evidence",
    "$ev2"
   ],
   "exit": 3,
   "reasons": [
    "image-gate-missing"
   ]
  },
  {
   "cli": [
    "gate",
    "open",
    "$sid",
    "$dev",
    "format"
   ],
   "runner": {
    "capture": "windows/baseline-nvme-only"
   },
   "exit": 3,
   "reasons": [
    "device-not-found"
   ]
  }
 ],
 "structural_reason": "No real HDD-behind-USB-dock capture on Windows (SOURCES.md 'No real sample yet'): the HDD is known only via ingest, so the format gate ends at device-not-found and the self-test/PASS matrix steps cannot run. Amendment 02 C: with no attached HDD no image-ddrescue gate can run, so even the full-coverage map cannot secure the data (image-gate-missing).",
 "amended": "amendment 02 C"
}
