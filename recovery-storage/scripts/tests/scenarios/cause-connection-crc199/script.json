{
 "name": "cause-connection-crc199",
 "structural": false,
 "covers": [
  "G1:connection-cable-power-bridge"
 ],
 "steps": [
  {
   "cli": [
    "session",
    "new",
    "--goal",
    "diagnosis-only"
   ],
   "save": {
    "sid": "session.id"
   }
  },
  {
   "cli": [
    "ingest",
    "smartctl",
    "@fx:smartctl/scrutiny-ata-ssd-crc199.json",
    "--session",
    "$sid"
   ],
   "save": {
    "dev": "device_id"
   }
  },
  {
   "cli": [
    "assess",
    "$sid",
    "$dev"
   ]
  }
 ]
}
